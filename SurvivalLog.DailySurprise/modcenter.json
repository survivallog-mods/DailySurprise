{
  "mcSpec": 2,
  "suite": true,
  "id": "com.local.survivallog.dailysurprise",
  "display": "喜从天降",
  "en": "DailySurprise",
  "summary": "每个游戏日睡醒随机降临一个天降事件：好运/平淡/霉运三轴掷骰，45 个事件全量首发，难度五档一键切换。",
  "usage": {
    "intro": "每个游戏日睡醒时随机降临一个「天降事件」——好运（物资/buff）、平淡或霉运（debuff/损失），给重复的生存日常加「每天开箱」的期待感。",
    "sections": [
      {
        "heading": "怎么用",
        "bullets": [
          "装好即用，无需设置；仅灾后生效（普通档 + 无尽档），灾前序章完全静默",
          "每天至多一次，默认凌晨 1 点睡醒后触发（「触发小时」可改，0=日结算时立即触发）",
          "同一天读档重睡不会重复触发；整体基调偏奖励、黑色幽默生活流",
          "难度档一键切换：想天天开箱爽选幸运儿/顺风局，想给长期档加压力选命运多舛/厄运缠身"
        ]
      },
      {
        "heading": "提示",
        "bullets": [
          "45 个事件：平淡 5 / 好运 22 / 霉运 18；好运内分普通→稀有→史诗→传说，霉运内分轻度→中度→重度→灾厄",
          "连续霉运有保底（难度 4/5 档外），连续 N 天霉运后强制好运一天",
          "永久负面事件有心结/代价/低语各 1 次的上限，达上限自动换替补；也可用「允许永久负面」整体关闭",
          "事件卡未弹出时（气泡模式/极端兜底）奖励照发不丢；背包满自动挂账，下次进档补发",
          "总开关关闭 = 立即停止全部天降事件；已获得的 buff/物品按游戏自身数据自然消退"
        ]
      }
    ]
  },
  "groups": [
    {
      "title": "难度与运势",
