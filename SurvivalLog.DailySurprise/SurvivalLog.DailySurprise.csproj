<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SurvivalLog.DailySurprise</AssemblyName>
    <RootNamespace>SurvivalLog.DailySurprise</RootNamespace>
    <Version>1.0.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../ModShared/BagTableRw.cs" />
    <Compile Include="../ModShared/WelcomeTip.cs" />
    <!-- Art\*.webp：Task 11 图片生产线 v2（4:3 横版 1536×1152 WebP，对齐官方原生事件图）；
         目录未建时 glob 匹配空集不报错 -->
    <EmbeddedResource Include="Art\*.webp" />
    <!-- ModCenter mcSpec 2 声明式配置清单（套件标准，2026-11-15 起）：内嵌后 ModCenter 反射读取渲染面板页 -->
    <EmbeddedResource Include="modcenter.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SurvivalLog.DailySurprise.Tests" />
  </ItemGroup>

