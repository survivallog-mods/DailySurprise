    <Compile Include="../SurvivalLog.DailySurprise/Core/StateStore.cs" />
    <Compile Include="../SurvivalLog.DailySurprise/Core/RewardMath.cs" />
    <Compile Include="../SurvivalLog.DailySurprise/Core/IconNaming.cs" />
    <Compile Include="../SurvivalLog.DailySurprise/Core/RegistrarPlan.cs" />
    <!-- DailyFlow 纯函数半边（partial 类的纯侧）：il2cpp 接线半边在主工程 DailyFlow.Runtime.cs，不链接 -->
    <Compile Include="../SurvivalLog.DailySurprise/Game/Trigger/DailyFlow.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.5.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
